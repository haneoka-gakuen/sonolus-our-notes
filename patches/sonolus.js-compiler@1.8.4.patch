--- /dev/null
+++ b/dist/ir/optimize/propagate/analyze/first-entry-index.js
@@ -0,0 +1,11 @@
+/** Local index for an immutable propagation state. Keep the first === match.
+ * Map uses SameValueZero, so NaN keys must remain absent as in myMapGet.
+ */
+export const firstEntryIndex = (state) => {
+    const index = new Map();
+    for (const { k, v } of state) {
+        if (k !== k || index.has(k)) continue;
+        index.set(k, v);
+    }
+    return index;
+};
