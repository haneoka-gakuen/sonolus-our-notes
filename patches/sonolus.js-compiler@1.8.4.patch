+// MyMap uses the first === key match; Map's NaN-key match must remain absent.
+export const indexEntries = (entries) => {
+    const index = new Map();
+    for (const { k, v } of entries) {
+        if (k !== k || index.has(k)) continue;
+        index.set(k, v);
+    }
+    return index;
+};
+export const compareCountEntries = (a, b) => {
+    if (a === b) return true;
+    if (a.length !== b.length) return false;
+    const index = indexEntries(b);
+    for (const { k, v } of a) {
+        const value = k === k ? index.get(k) : undefined;
+        if (value === undefined || v !== value) return false;
+    }
+    return true;
+};
+export const mergeCountEntries = (a, b) => {
+    if (a === b) return a;
+    const left = indexEntries(a), right = indexEntries(b);
+    const keys = new Set([...a.map(({ k }) => k), ...b.map(({ k }) => k)]);
+    const result = [];
+    for (const k of keys) {
+        const valueA = k === k ? left.get(k) : undefined;
+        const valueB = k === k ? right.get(k) : undefined;
+        const v = valueA === 'T' || valueB === 'T' ? 'T' : valueA ?? valueB;
+        if (v !== undefined) result.push({ k, v });
+    }
+    return result;
+};
