+import { firstEntryIndex } from './first-entry-index.js';
+export const meetPropagateStates = (a, b) => {
+    if (a === b) return a;
+    const left = firstEntryIndex(a);
+    const right = firstEntryIndex(b);
+    // The existing Set defines insertion order and normalizes -0 keys.
+    const keys = new Set([...a.map(({ k }) => k), ...b.map(({ k }) => k)]);
+    const result = [];
+    for (const k of keys) {
+        const elementA = k === k ? left.get(k) : undefined;
+        const elementB = k === k ? right.get(k) : undefined;
+        const v = elementA === 'T' || elementB === 'T' ? 'T'
+            : !elementA || !elementB ? elementA ?? elementB
+            : elementA.value === elementB.value ? elementA : 'T';
+        if (v !== undefined) result.push({ k, v });
+    }
+    return result;
+};
