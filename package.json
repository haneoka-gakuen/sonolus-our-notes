{
  "name": "@haneoka/sonolus-our-notes",
  "private": false,
  "description": "Standalone Sonolus play, watch, preview, and tutorial engine for Our Notes charts",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/sonolus-our-notes.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/sonolus-our-notes#readme",
  "type": "module",
  "files": [
    "dist",
    "contract",
    "optionaltools",
    "LICENSE",
    "LICENSE.pjsekai.txt",
    "NOTICE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck:tools && node ./scripts/build.ts",
    "typecheck:tools": "tsc --project ./tsconfig.tools.json",
    "check": "pnpm run typecheck:tools && pnpm run verify:contract",
    "verify:contract": "node ./scripts/verify-contract.ts",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@sonolus/core": "7.15.4"
  },
  "devDependencies": {
    "@sonolus/express": "7.5.4",
    "@sonolus/free-pack": "1.2.0",
    "@sonolus/sonolus.js": "9.7.4",
    "@sonolus/sonolus.js-compiler": "1.8.4",
    "@types/node": "22.20.1",
    "multer": "2.2.0",
    "typebox": "1.3.7",
    "typescript": "5.8.3"
  },
  "version": "0.1.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./contract/native-effects.json": "./contract/native-effects.json",
    "./dist/*": "./dist/*"
  }
}
